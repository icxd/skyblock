package net.icxd.dungeons.item.items;

import net.icxd.dungeons.item.SkyBlockItem;
import net.icxd.dungeons.item.enums.Rarity;
import net.icxd.dungeons.item.enums.SpecificItemType;
import net.icxd.dungeons.item.gemstone.GemstoneType;
import net.icxd.dungeons.utils.Utils;
import org.bukkit.Material;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * The 40 gemstones: each of the eight gemstone types at each of the five qualities, as Hypixel shows
 * them (text from the NEU item repository's dumps, head textures from this plugin's old items).
 * Generated by tools/items/gen_tables.py, apart from the code under the table.
 */
public final class Gemstones {
    private Gemstones() {
    }

    /** Rarity and NPC sell price by quality. */
    enum Quality {
        ROUGH("Rough", Rarity.COMMON, 3),
        FLAWED("Flawed", Rarity.UNCOMMON, 240),
        FINE("Fine", Rarity.RARE, 19_200),
        FLAWLESS("Flawless", Rarity.EPIC, 1_536_000),
        PERFECT("Perfect", Rarity.LEGENDARY, 10_240_000);

        final String name;
        final Rarity rarity;
        final double sellPrice;

        Quality(String name, Rarity rarity, double sellPrice) {
            this.name = name;
            this.rarity = rarity;
            this.sellPrice = sellPrice;
        }
    }

    /** The eight types there are gemstones of, and the stat each gives ("extra ❤ Health"). */
    private static final Map<GemstoneType, String> STAT = Map.of(
            GemstoneType.RUBY, "&c❤ Health", GemstoneType.AMETHYST, "&a❈ Defense", GemstoneType.JADE, "&6☘ Mining Fortune",
            GemstoneType.SAPPHIRE, "&b✎ Intelligence", GemstoneType.AMBER, "&6⸕ Mining Speed", GemstoneType.TOPAZ, "&5✧ Pristine",
            GemstoneType.JASPER, "&c❁ Strength", GemstoneType.OPAL, "&f❂ True Defense");

    private record Text(String texture, List<String> intro) {
    }

    private static final Map<String, Text> TEXT = new HashMap<>();

    private static void entry(String id, String texture, String... intro) {
        TEXT.put(id, new Text(texture, List.of(intro)));
    }

    static {
@@TEXT@@;
    }

    public static List<SkyBlockItem> all() {
        List<SkyBlockItem> items = new ArrayList<>();
        for (GemstoneType type : STAT.keySet()) for (Quality quality : Quality.values()) items.add(new Gem(type, quality));
        items.sort(java.util.Comparator.comparing(SkyBlockItem::id));
        return items;
    }

    private record Gem(GemstoneType type, Quality quality) implements SkyBlockItem {
        @Override public String id() { return quality.name() + "_" + type.name() + "_GEM"; }
        @Override public String name() { return type.getIcon() + " " + quality.name + " " + type.getName() + " Gemstone"; }
        @Override public Material material() { return Material.PLAYER_HEAD; }
        @Override public Rarity rarity() { return quality.rarity; }
        @Override public String skin() { return Utils.texture(TEXT.get(id()).texture()); }
        @Override public SpecificItemType specificItemType() { return SpecificItemType.GEMSTONE; }
        @Override public List<String> categories() { return List.of("Collection Item"); }
        @Override public double npcSellPrice() { return quality.sellPrice; }

        @Override
        public List<String> lore() {
            List<String> lore = new ArrayList<>(TEXT.get(id()).intro());
            lore.add("");
            lore.add("&7Some say that when &eharnessed");
            lore.add("&eproperly&7, it can give its owner extra");
            lore.add(STAT.get(type) + "&7.");
            return lore;
        }
    }
}
