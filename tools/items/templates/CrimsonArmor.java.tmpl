package net.icxd.dungeons.item.items;

import net.icxd.dungeons.crimsonisle.kuudra.KuudraTier;
import net.icxd.dungeons.item.SkyBlockItem;
import net.icxd.dungeons.item.cost.UpgradeCost;
import net.icxd.dungeons.item.cost.UpgradeCosts;
import net.icxd.dungeons.item.cost.essence.EssenceCost;
import net.icxd.dungeons.item.cost.essence.EssenceType;
import net.icxd.dungeons.item.cost.item.ItemCost;
import net.icxd.dungeons.item.enums.Rarity;
import net.icxd.dungeons.item.enums.SpecificItemType;
import net.icxd.dungeons.item.gemstone.GemstoneSlot;
import net.icxd.dungeons.item.gemstone.GemstoneSlots;
import net.icxd.dungeons.item.requirement.KuudraTierRequirement;
import net.icxd.dungeons.item.requirement.Requirements;
import net.icxd.dungeons.item.requirement.skill.SkillRequirement;
import net.icxd.dungeons.skill.Skill;
import net.icxd.dungeons.stats.Stats;
import net.icxd.dungeons.utils.Utils;
import org.bukkit.Color;
import org.bukkit.Material;

import java.util.ArrayList;
import java.util.List;

import static net.icxd.dungeons.stats.Stat.CRIT_DAMAGE;
import static net.icxd.dungeons.stats.Stat.DEFENSE;
import static net.icxd.dungeons.stats.Stat.HEALTH;
import static net.icxd.dungeons.stats.Stat.INTELLIGENCE;
import static net.icxd.dungeons.stats.Stat.STRENGTH;

/**
 * Kuudra's Crimson armor: four pieces in five tiers, Crimson to Infernal. Stats and text are
 * Hypixel's (the NEU item repository's dumps); the star costs are this plugin's.
 * Generated by tools/items/gen_tables.py, apart from the code under the tier table.
 */
public final class CrimsonArmor {
    private CrimsonArmor() {
    }

    enum Tier {
@@TIERS@@

        final String prefix;
        final String idPrefix;
        final KuudraTier kuudra;
        final int combatLevel;
        final String helmetTexture;
        /** The Dominus tiered bonus, as each piece of the tier shows it. */
        final List<String> bonus;
        final List<UpgradeCost> stars;
        final List<Stats> stats;

        Tier(String prefix, String idPrefix, KuudraTier kuudra, int combatLevel, String helmetTexture, List<String> bonus,
             List<UpgradeCost> stars, Stats helmet, Stats chestplate, Stats leggings, Stats boots) {
            this.prefix = prefix;
            this.idPrefix = idPrefix;
            this.kuudra = kuudra;
            this.combatLevel = combatLevel;
            this.helmetTexture = helmetTexture;
            this.bonus = bonus;
            this.stars = stars;
            this.stats = List.of(helmet, chestplate, leggings, boots);
        }
    }

    enum Piece {
        HELMET("Helmet", Material.PLAYER_HEAD, SpecificItemType.HELMET, null),
        CHESTPLATE("Chestplate", Material.LEATHER_CHESTPLATE, SpecificItemType.CHESTPLATE, Color.fromRGB(0xFF6F0C)),
        LEGGINGS("Leggings", Material.LEATHER_LEGGINGS, SpecificItemType.LEGGINGS, Color.fromRGB(0xE66105)),
        BOOTS("Boots", Material.LEATHER_BOOTS, SpecificItemType.BOOTS, Color.fromRGB(0xE65300));

        final String name;
        final Material material;
        final SpecificItemType type;
        final Color color;

        Piece(String name, Material material, SpecificItemType type, Color color) {
            this.name = name;
            this.material = material;
            this.type = type;
            this.color = color;
        }
    }

    public static List<SkyBlockItem> all() {
        List<SkyBlockItem> items = new ArrayList<>();
        for (Tier tier : Tier.values()) for (Piece piece : Piece.values()) items.add(new Item(tier, piece));
        return items;
    }

    private static UpgradeCost star(int essence) {
        return new UpgradeCost(new EssenceCost(EssenceType.CRIMSON, essence));
    }

    private static UpgradeCost star(int essence, int heavyPearls) {
        return new UpgradeCost(new EssenceCost(EssenceType.CRIMSON, essence), new ItemCost("HEAVY_PEARL", heavyPearls));
    }


    private record Item(Tier tier, Piece piece) implements SkyBlockItem {
        @Override public String id() { return tier.idPrefix + "CRIMSON_" + piece.name(); }
        @Override public String name() { return tier.prefix + "Crimson " + piece.name; }
        @Override public Material material() { return piece.material; }
        @Override public Rarity rarity() { return Rarity.LEGENDARY; }
        @Override public String skin() { return piece == Piece.HELMET ? Utils.texture(tier.helmetTexture) : null; }
        @Override public Color color() { return piece.color; }
        @Override public SpecificItemType specificItemType() { return piece.type; }
        @Override public Stats stats() { return tier.stats.get(piece.ordinal()).copy(); }
        @Override public GemstoneSlots gemstoneSlots() { return new GemstoneSlots(GemstoneSlot.combat(), GemstoneSlot.combat()); }
        @Override public List<String> lore() { return tier.bonus; }
        @Override public Requirements requirements() {
            return new Requirements(new SkillRequirement(Skill.COMBAT, tier.combatLevel), new KuudraTierRequirement(tier.kuudra));
        }
        @Override public UpgradeCosts upgradeCosts() { return new UpgradeCosts(tier.stars.toArray(UpgradeCost[]::new)); }
        @Override public boolean canHaveAttributes() { return true; }
    }
}
